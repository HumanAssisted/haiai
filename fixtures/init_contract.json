{
  "bootstrap_register": {
    "method": "POST",
    "path": "/api/v1/agents/register",
    "auth_required": false,
    "public_key_encoding": "base64"
  },
  "existing_identity_register": {
    "response": {
      "agent_id": "registered-existing-agent",
      "jacs_id": "fixture-existing-agent",
      "registered_at": "2026-09-13T00:00:00Z"
    },
    "cases": [
      {
        "name": "admitted_with_key",
        "request": {
          "agent_json": "{\n  \"jacsId\": \"fixture-existing-agent\",\n  \"jacsName\": \"existing-agent\"\n}",
          "owner_email": "owner@example.test",
          "registration_key": "hk_0123456789aBcDeF0123456789aBcDeF0123456789aBcDeF0123456789aBcDeF",
          "public_key_pem": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEvVmg3QKS7aNKq2Y5fdZNLhS+uOg9\npVLVQaRXBjJ+EqZLb7uqQJaF98JA5SXXEBcPN0HNyTF1v6g/ZEYGsGhT0g==\n-----END PUBLIC KEY-----\n"
        }
      },
      {
        "name": "key_omitted",
        "request": {
          "agent_json": "{\n  \"jacsId\": \"fixture-existing-agent\",\n  \"jacsName\": \"existing-agent\"\n}",
          "owner_email": "owner@example.test",
          "public_key_pem": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEvVmg3QKS7aNKq2Y5fdZNLhS+uOg9\npVLVQaRXBjJ+EqZLb7uqQJaF98JA5SXXEBcPN0HNyTF1v6g/ZEYGsGhT0g==\n-----END PUBLIC KEY-----\n"
        }
      },
      {
        "name": "public_key_omitted",
        "request": {
          "agent_json": "{\n  \"jacsId\": \"fixture-existing-agent\",\n  \"jacsName\": \"existing-agent\"\n}",
          "owner_email": "owner@example.test"
        }
      }
    ],
    "public_key_pem_source": "media/verifier-agent/keys/jacs.ecosystem.public.pem"
  },
  "private_key_candidate_order": [
    "agent_private_key.pem",
    "{agentName}.private.pem",
    "private_key.pem"
  ],
  "config_discovery_order": [
    "explicit_path",
    "JACS_CONFIG_PATH",
    "./jacs.config.json"
  ],
  "private_key_password_sources": [
    "JACS_PRIVATE_KEY_PASSWORD",
    "JACS_PASSWORD_FILE"
  ],
  "private_key_password_strategy": "single_source_required"
}
