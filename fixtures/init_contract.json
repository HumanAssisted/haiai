{
  "bootstrap_register": {
    "method": "POST",
    "path": "/api/v1/agents/register",
    "auth_required": false,
    "public_key_encoding": "base64"
  },
  "existing_identity_register": {
    "response": {
      "agent_id": "registered-existing-agent",
      "jacs_id": "fixture-existing-agent",
      "registered_at": "2026-09-13T00:00:00Z"
    },
    "cases": [
      {
        "name": "admitted_with_key",
        "request": {
          "agent_json": "{\n  \"jacsId\": \"fixture-existing-agent\",\n  \"jacsName\": \"existing-agent\"\n}",
          "owner_email": "owner@example.test",
          "registration_key": "hk_0123456789aBcDeF0123456789aBcDeF0123456789aBcDeF0123456789aBcDeF",
          "public_key_pem": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEvVmg3QKS7aNKq2Y5fdZNLhS+uOg9\npVLVQaRXBjJ+EqZLb7uqQJaF98JA5SXXEBcPN0HNyTF1v6g/ZEYGsGhT0g==\n-----END PUBLIC KEY-----\n"
        }
      },
      {
        "name": "key_omitted",
        "request": {
          "agent_json": "{\n  \"jacsId\": \"fixture-existing-agent\",\n  \"jacsName\": \"existing-agent\"\n}",
          "owner_email": "owner@example.test",
          "public_key_pem": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEvVmg3QKS7aNKq2Y5fdZNLhS+uOg9\npVLVQaRXBjJ+EqZLb7uqQJaF98JA5SXXEBcPN0HNyTF1v6g/ZEYGsGhT0g==\n-----END PUBLIC KEY-----\n"
        }
      },
      {
        "name": "public_key_omitted",
        "request": {
          "agent_json": "{\n  \"jacsId\": \"fixture-existing-agent\",\n  \"jacsName\": \"existing-agent\"\n}",
          "owner_email": "owner@example.test"
        }
      }
    ],
    "public_key_pem_source": "media/verifier-agent/keys/jacs.ecosystem.public.pem"
  },
  "private_key_candidate_order": [
    "agent_private_key.pem",
    "{agentName}.private.pem",
    "private_key.pem"
  ],
  "config_discovery_order": [
    "explicit_path",
    "JACS_CONFIG_PATH",
    "./jacs.config.json"
  ],
  "private_key_password_sources": [
    "JACS_PRIVATE_KEY_PASSWORD",
    "JACS_PASSWORD_FILE"
  ],
  "private_key_password_strategy": "single_source_required",
  "registration_outcomes": {
    "requested_name": "requested-agent",
    "cases": [
      {
        "name": "registered_actual_email",
        "http_status": 201,
        "response": {
          "success": true,
          "agent_id": "assigned-agent-id",
          "jacs_id": "fixture-existing-agent",
          "registration_status": "registered",
          "email": "assigned-different@hai.ai",
          "registered_at": "2026-09-13T00:00:00Z"
        },
        "expected_status": "registered",
        "expected_email": "assigned-different@hai.ai",
        "cli_exit_success": true
      },
      {
        "name": "pending_without_email",
        "http_status": 202,
        "response": {
          "success": true,
          "agent_id": "pending-agent-id",
          "jacs_id": "fixture-existing-agent",
          "registration_status": "pending_verification"
        },
        "expected_status": "pending_verification",
        "expected_email": null,
        "cli_exit_success": true
      },
      {
        "name": "missing_status",
        "http_status": 200,
        "response": {
          "agent_id": "legacy-agent-id",
          "jacs_id": "fixture-existing-agent"
        },
        "expected_status": null,
        "expected_email": null,
        "cli_exit_success": true
      },
      {
        "name": "unknown_status",
        "http_status": 200,
        "response": {
          "agent_id": "future-agent-id",
          "jacs_id": "fixture-existing-agent",
          "registration_status": "awaiting_operator_review"
        },
        "expected_status": "awaiting_operator_review",
        "expected_email": null,
        "cli_exit_success": true
      },
      {
        "name": "registration_refused",
        "http_status": 403,
        "response": {
          "message": "Registration key was not accepted for admission"
        },
        "expected_status": null,
        "expected_email": null,
        "cli_exit_success": false
      }
    ]
  },
  "registration_submission": {
    "maximum_requests": 1,
    "generic_retry_limits": [
      0,
      3
    ],
    "retryable_http_statuses": [
      429,
      500,
      502,
      503,
      504
    ],
    "redirect_http_statuses": [
      301,
      302,
      303,
      307,
      308
    ]
  }
}
