{
  "base_url": "https://hai.ai",
  "hello": {
    "method": "POST",
    "path": "/api/v1/agents/hello",
    "auth_required": true
  },
  "submit_response": {
    "method": "POST",
    "path": "/api/v1/agents/jobs/{job_id}/response",
    "auth_required": true,
    "signed_context": {
      "contextClass": "private_event",
      "eventType": "job_response",
      "contract": "hai.job-response",
      "contractVersion": "2",
      "transport": {"type": "channel", "value_template": "job:{job_id}"},
      "causation": {"type": "job", "id_template": "{job_id}"},
      "expected_config": ["expected_event_tenant", "response_audience"]
    }
  },
  "update_labels": {
    "method": "POST",
    "path": "/api/agents/{agent_id}/email/messages/{message_id}/labels",
    "auth_required": true
  },
  "reply": {
    "method": "POST",
    "path": "/api/agents/{agent_id}/email/reply",
    "auth_required": true
  },
  "get_raw_email": {
    "method": "GET",
    "path": "/api/agents/{agent_id}/email/messages/{message_id}/raw",
    "auth_required": true
  }
}
